# Clave de Google Maps JavaScript API (o Maps Demo Key para el prototipo).
# Cada integrante copia a .env.local, completa su propia clave y reinicia npm run dev.
# .env.example es una plantilla; .env.local no se sube a GitHub.
VITE_GOOGLE_MAPS_API_KEY=

# DEMO_MAP_ID sirve para desarrollo. Para publicar, usar un Map ID propio.
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
